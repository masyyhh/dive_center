# Imported inside a route AFTER the original deployment's proxy checks.
@versionChooser {
  path /
  query version=choose
}
handle @versionChooser {
  root * /opt/parallel
  rewrite * /version-chooser.html
  header >Cache-Control "no-store"
  file_server
}
@testingEntry {
  path /
  query version=testing
}
handle @testingEntry {
  header >Cache-Control "no-store"
  header >X-App-Version testing
  reverse_proxy testweb:8080 {
    header_up X-Forwarded-For {client_ip}
    header_up X-Forwarded-Proto https
  }
}
redir /__testing /?version=testing 302
handle_path /__testing/* {
  header >Cache-Control "no-store"
  header >X-App-Version testing
  reverse_proxy testweb:8080 {
    header_up X-Forwarded-For {client_ip}
    header_up X-Forwarded-Proto https
  }
}
@api path /api /api/*
handle @api {
  header >Cache-Control "no-store"
  reverse_proxy backend:5001 {
    header_up X-Forwarded-For {client_ip}
    header_up X-Forwarded-Proto https
  }
}
handle /assets/* {
  root * /srv
  header Cache-Control "public, max-age=31536000, immutable"
  file_server
}
handle {
  root * /srv
  try_files {path} /index.html
  header Cache-Control "no-cache"
  file_server
}
