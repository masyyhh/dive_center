{
  admin off
  auto_https off
  servers {
    trusted_proxies static {$NPM_PROXY_IP}
    trusted_proxies_strict
  }
}

:8080 {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    -Server
  }
  route {
    # Check the TCP peer, never a client-supplied forwarded IP.
    @untrusted not remote_ip {$NPM_PROXY_IP}
    respond @untrusted "Access through the configured reverse proxy is required." 403
    @insecure not header X-Forwarded-Proto https
    respond @insecure "HTTPS is required through the reverse proxy." 403
    @api path /api /api/*
    handle @api {
      header Cache-Control "no-store"
      reverse_proxy backend:5001 {
        # Pass one parsed client address, not an arbitrary incoming XFF chain.
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto https
      }
    }
    handle /assets/* {
      root * /srv
      header Cache-Control "public, max-age=31536000, immutable"
      file_server
    }
    handle {
      root * /srv
      try_files {path} /index.html
      header Cache-Control "no-cache"
      file_server
    }
  }
}
