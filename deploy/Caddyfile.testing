{
  admin off
  auto_https off
  servers {
    trusted_proxies static {$TESTING_GATEWAY_IP}
    trusted_proxies_strict
  }
}
:8080 {
  route {
    @untrusted not remote_ip {$TESTING_GATEWAY_IP}
    respond @untrusted "Use the live site's testing link." 403
    @insecure not header X-Forwarded-Proto https
    respond @insecure "HTTPS is required." 403
    header >Cache-Control "no-store"
    @api path /api /api/*
    handle @api {
      reverse_proxy testbackend:5001 {
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto https
      }
    }
    handle {
      root * /srv
      try_files {path} /index.html
      file_server
    }
  }
}
