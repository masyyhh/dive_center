PORT=5001
# Local URLs are written privately by: node scripts/local-postgres.cjs start
DATABASE_URL=postgresql://dive_center:CHANGE_ME@127.0.0.1:55432/dive_center?schema=public
# Integration tests require a separate database whose name ends in _test.
TEST_DATABASE_URL=postgresql://dive_center:CHANGE_ME@127.0.0.1:55432/dive_center_test?schema=public
# Run node ../scripts/setup-local-secrets.cjs to create a private development key.
JWT_SECRET=
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Authenticator recovery uses a persistent independent encryption key.
# Local: node scripts/setup-authenticator-key.cjs from the repository root.
# Production: prepare-production.cjs generates secrets/authenticator_key.
AUTHENTICATOR_ENCRYPTION_KEY=

# PMS guest lookup: server-side key, never expose it in frontend settings.
PMS_API_KEY=
# Alternatively configure PMS_API_KEY_FILE instead (non-Compose deployments).
