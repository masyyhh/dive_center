generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id                  String         @id @default(uuid())
  code                String         @unique // e.g. "SUN-MLE", "SUN-ARI"
  name                String         // e.g. "Sun Diving - Malé Atoll"
  deletedAt           DateTime?      // Removed from the workspace; historical records are retained.
  pmsPropertyCode     String?        // OLHU, SSO, SW, MLEIR, SAIV, VILU, AQUA
  location            String?
  currency            String         @default("USD")
  currencySymbol      String         @default("$")
  taxRate             Float          @default(16.0) // 16% TGST / Tax
  serviceChargeRate   Float          @default(10.0) // 10% Service Charge
  nextCheckNumber     Int            @default(1001)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  users               UserProperty[]
  staffMembers        StaffMember[]
  categories          Category[]
  items               Item[]
  bills               Bill[]
  attendanceRecords   Attendance[]
  monthLocks          MonthLock[]
  auditLogs           AuditLog[]
}

model User {
  id                  String         @id @default(uuid())
  username            String         @unique
  email               String?
  authenticator       Authenticator?
  name                String
  mustChangePassword  Boolean        @default(false)
  passwordReset       PasswordReset?
  passwordHash        String
  role                String         @default("CENTRE_STAFF") // "GLOBAL_ADMIN", "PROPERTY_MANAGER", "CENTRE_STAFF"
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  assignedProperties  UserProperty[]
  createdBills        Bill[]         @relation("CreatedBills")
  auditLogs           AuditLog[]
  monthLocksCreated   MonthLock[]

  @@index([email])
}

model UserProperty {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model StaffMember {
  id                    String        @id @default(uuid())
  propertyId            String
  name                  String
  email                 String?
  roleTitle             String        // e.g. "Base Leader", "Assistant Base Leader", "Instructor", "Divemaster", "Photographer"
  isDiveStaff           Boolean       @default(true)  // Only dive staff appear in Presence & share pools
  isCoursePoolSharing   Boolean       @default(false) // e.g. Base Leader, Assistant Base Leader, Instructor
  isDivePoolSharing     Boolean       @default(true)  // All dive staff
  isBaseLeaderOverride  Boolean       @default(false) // Receives +10% base-leader override
  hireDate              String        // YYYY-MM-DD
  leavingDate           String?       // YYYY-MM-DD (null if actively employed)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  property              Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  attendances           Attendance[]
  sellerLines           BillItem[]    @relation("SellerStaff")
  guideLines            BillItem[]    @relation("GuideStaff")
  instructorLines       BillItem[]    @relation("InstructorStaff")
  photoLines            BillItem[]    @relation("PhotoStaff")
  videoLines            BillItem[]    @relation("VideoStaff")
}

model Category {
  id          String   @id @default(uuid())
  propertyId  String
  name        String   // "Courses", "Dives", "Excursions", "Rentals", "Photo & Video", "Retail"
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  items       Item[]

  @@unique([propertyId, name])
}

model Item {
  id                 String     @id @default(uuid())
  propertyId         String
  categoryId         String
  code               String     // e.g. "DIVE-01", "CRS-OWD"
  name               String     // e.g. "Single Boat Dive", "Open Water Diver"
  price              Float      // e.g. 75.00
  poolType           String     @default("NONE") // "COURSE_POOL", "DIVE_POOL", "NONE"
  poolContribution   Float      @default(0.0)    // Amount or share contributed to the pool
  // Comma-separated roles with personal commission, e.g. "seller,instructor" or "photo"
  personalRoles      String?    
  // JSON string defining fixed per-line amount per role, e.g. '{"seller":10, "instructor":25}'
  personalRatesJson  String?    
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  property           Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category           Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  billItems          BillItem[]

  @@unique([propertyId, code])
}

model Bill {
  id                  String     @id @default(uuid())
  propertyId          String
  checkNumber         Int        // Check # e.g. 1001, matching Micros check
  businessDate        String     // YYYY-MM-DD
  guestName           String
  roomNumber          String
  departureDate       String?    // YYYY-MM-DD
  nationality         String     @default("Other")
  
  grossAmount         Float      @default(0.0)
  discountAmount      Float      @default(0.0)
  serviceChargeAmount Float      @default(0.0)
  taxAmount           Float      @default(0.0)
  tipAmount           Float      @default(0.0)
  netAmount           Float      @default(0.0)
  
  // JSON array of staff IDs who split the bill tip
  tipStaffIdsJson     String?    // e.g. '["id1","id2"]'

  status              String     @default("ACTIVE") // "ACTIVE", "REBATED", "DELETED"
  rebateReason        String?
  rebatedFromBillId   String?    // If this bill is an adjustment reversing an earlier bill
  notes               String?

  createdById         String
  createdBy           User       @relation("CreatedBills", fields: [createdById], references: [id])
  property            Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  items               BillItem[]
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Partial live-check uniqueness is enforced by SQL migration; Prisma 5 cannot model it.
  @@index([propertyId, businessDate])
  @@index([propertyId, status])
}

model BillItem {
  id                      String       @id @default(uuid())
  billId                  String
  itemId                  String?
  itemName                String
  categoryName            String
  quantity                Int          @default(1)
  unitPrice               Float
  discountPercent         Float        @default(0.0)
  lineTotal               Float        // (unitPrice * quantity) - discount
  
  // Personal commission assignments
  sellerStaffId           String?
  guideStaffId            String?
  instructorStaffId       String?
  photoStaffId            String?
  videoStaffId            String?

  // Personal commissions breakdown JSON: e.g. '{"seller":10, "instructor":20}'
  personalCommissionsJson String?
  totalPersonalCommission Float        @default(0.0)

  bill                    Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  item                    Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  sellerStaff             StaffMember? @relation("SellerStaff", fields: [sellerStaffId], references: [id])
  guideStaff              StaffMember? @relation("GuideStaff", fields: [guideStaffId], references: [id])
  instructorStaff         StaffMember? @relation("InstructorStaff", fields: [instructorStaffId], references: [id])
  photoStaff              StaffMember? @relation("PhotoStaff", fields: [photoStaffId], references: [id])
  videoStaff              StaffMember? @relation("VideoStaff", fields: [videoStaffId], references: [id])

  createdAt               DateTime     @default(now())
}

model Attendance {
  id             String      @id @default(uuid())
  propertyId     String
  staffMemberId  String
  date           String      // YYYY-MM-DD
  // "PRESENT", "OFF", "OFF_HALF", "ANNUAL_LEAVE", "SICK", "ABSENT", "EMERGENCY_LEAVE"
  status         String      @default("PRESENT") 
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  property       Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  staffMember    StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([propertyId, staffMemberId, date])
  @@index([propertyId, date])
}

model MonthLock {
  id         String   @id @default(uuid())
  propertyId String
  yearMonth  String   // "YYYY-MM", e.g. "2026-10"
  isLocked   Boolean  @default(true)
  lockedAt   DateTime @default(now())
  lockedById String

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lockedBy   User     @relation(fields: [lockedById], references: [id])

  @@unique([propertyId, yearMonth])
}

model AuditLog {
  id         String   @id @default(uuid())
  propertyId String?
  userId     String?
  action     String   // "BILL_CREATE", "BILL_REDATE", "BILL_REBATE", "BILL_DELETE", "ATTENDANCE_UPDATE", "MONTH_LOCK", "MONTH_UNLOCK", "USER_CREATE", "PASSWORD_RESET", "LOGIN_FAILED", "ACCOUNT_LOCKED"
  targetType String   // "Bill", "Attendance", "User", "Property", "MonthLock"
  targetId   String?
  details    String?  // JSON string with detailed change delta or context
  ipAddress  String?
  createdAt  DateTime @default(now())

  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
}

// One current password-reset grant per account. Tokens are stored only as keyed digests.
model PasswordReset {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash        String?
  tokenHash      String?  @unique
  credentialHash String
  authenticatorVersion String?
  attempts       Int      @default(0)
  requestedAt    DateTime
  expiresAt      DateTime
}

model Authenticator {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretCiphertext      String?
  pendingCiphertext     String?
  pendingExpiresAt      DateTime?
  pendingCredentialHash String?
  enrolledAt            DateTime?
  version               String   @default(uuid())
  lastUsedStep          Int      @default(-1)
  failedAttempts        Int      @default(0)
  lockedUntil           DateTime?
  recoveryCodeHashes    String   @default("[]")
}
