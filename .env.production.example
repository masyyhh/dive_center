# Mode A: Production WITH a domain (automatic HTTPS via Let's Encrypt / ZeroSSL):
# APP_DOMAIN=dive.example.com
# CORS_ORIGIN=https://dive.example.com
# ACME_EMAIL=ops@example.com

# Mode B: Production WITHOUT a domain (HTTP on port 80 / IP address):
APP_DOMAIN=:80
CORS_ORIGIN=http://<YOUR_SERVER_IP>,http://localhost,http://127.0.0.1
ACME_EMAIL=ops@dive-centre.local

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator

# Optional: pin reviewed upstream images as name:tag@sha256:<real digest>.
# NODE_IMAGE=node:22-bookworm-slim
# POSTGRES_IMAGE=postgres:18-bookworm
# CADDY_IMAGE=caddy:2-alpine

# Authenticator recovery uses a persistent independent encryption key.
# Local: node scripts/setup-authenticator-key.cjs from the repository root.
# Production: prepare-production.cjs generates secrets/authenticator_key.

# Compose reads the optional PMS key from secrets/pms_api_key (empty disables it).
# Put its value in that private file, never in frontend settings or Git.
# Direct non-Compose deployments can use PMS_API_KEY or PMS_API_KEY_FILE, not both.
