# Production requires an external HTTPS reverse proxy.
APP_DOMAIN=dive.example.com
CORS_ORIGIN=https://dive.example.com

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator

# Optional: pin reviewed upstream images as name:tag@sha256:<real digest>.
# NODE_IMAGE=node:22-bookworm
# POSTGRES_IMAGE=postgres:18-bookworm
# CADDY_IMAGE=caddy:2-alpine

# Authenticator recovery uses a persistent independent encryption key.
# Local: node scripts/setup-authenticator-key.cjs from the repository root.
# Production: prepare-production.cjs generates secrets/authenticator_key.

# Compose reads the optional PMS key from secrets/pms_api_key (empty disables it).
# Put its value in that private file, never in frontend settings or Git.
# Direct non-Compose deployments can use PMS_API_KEY or PMS_API_KEY_FILE, not both.

# External private reverse proxy: see deploy/REVERSE-PROXY.md.
# Base compose.yaml publishes HTTP upstreams; Caddy never requests certificates.
# Bind to this server's private IP for a remote proxy, or loopback for a local one.
# Set the actual proxy source address seen by Node; missing trust fails closed.
REVERSE_PROXY_BIND_IP=127.0.0.1
REVERSE_PROXY_TRUSTED_IPS=

# Optional relay mode when NPM forwards everything to 8080 (deploy/PROXY-RELAY.md).
# One exact NPM source IP; no changes to NPM routing required.
# NPM_PROXY_IP=192.168.135.63
# Change all three together only if the default relay subnet overlaps a network.
# PROXY_RELAY_SUBNET=172.30.251.0/29
# PROXY_RELAY_CADDY_IP=172.30.251.2
# PROXY_RELAY_BACKEND_IP=172.30.251.3
